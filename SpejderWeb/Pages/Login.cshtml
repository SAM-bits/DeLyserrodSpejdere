@page
@model SpejderWeb.Pages.LoginModel
@{

	Layout = "AllUser";
}

<div style="text-align: center; margin-top: 50px;">
	<h2>Login</h2>

	<form method="post">
		<br />

		<div>
			<label>Brugernavn </label><br />
			<input asp-for="UserName" />
		</div>
		<br />
		<div>
			<label>Kodeordet</label><br />
			<input asp-for="UserPassword" />
		</div>
		<br />
		<button type="submit" class="btn btn-secondary">Login</button>
	</form>
</div>